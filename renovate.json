{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices"
    ],
    "automerge": false,
    "prHourlyLimit": 2,
    "prConcurrentLimit": 5,
    "baseBranchPatterns": [
        "dev"
    ],
    "packageRules": [
        {
            "matchFiles": [
                "requirements.txt"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "major"
            ],
            "automerge": false
        },
        {
            "matchFiles": [
                "requirements.txt"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "auto"
        },
        {
            "matchFiles": [
                "dev-requirements.txt"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "dev"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "auto"
        }
    ]
}