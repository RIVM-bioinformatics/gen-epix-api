{
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.unusedImports": "explicit",
            "source.organizeImports.isort": "always",
        }
    },
    "isort.importStrategy": "fromEnvironment",
    "black-formatter.importStrategy": "fromEnvironment",
    "files.exclude": {
        "**/.git": false
    },
    "sonarlint.connectedMode.project": {
        "connectionId": "rivm-bioinformatics",
        "projectKey": "RIVM-bioinformatics_gen-epix-api"
    },
    "git.allowNoVerifyCommit": true,
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Use conventional commit format: type: description"
        },
        {
            "text": "Capitalize the first letter of the subject line"
        },
        {
            "text": "Do not end the subject line with a period"
        },
        {
            "text": "Use body for detailed explanation if needed"
        },
        {
            "text": "Separate subject from body with a blank line"
        },
        {
            "text": "Use bullet points for multiple changes in the body"
        },
        {
            "text": "Reference related issues or pull requests"
        },
        {
            "text": "Use emojis for visual clarity (optional)"
        },
        {
            "text": "Keep commit messages concise and clear"
        },
        {
            "text": "Avoid using 'WIP' in commit messages"
        },
        {
            "text": "Use present tense for the subject line"
        },
        {
            "text": "Use past tense for the body if describing completed work"
        },
        {
            "text": "Avoid using 'fixes' or 'closes' in the subject line"
        },
        {
            "text": "Use 'BREAKING CHANGE:' in the body for major changes"
        },
        {
            "text": "Use types: feat, fix, docs, style, refactor, perf, test, chore, ci"
        },
        {
            "text": "Reference issue numbers with # prefix"
        }
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "chat.agent.maxRequests": 50,
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
}