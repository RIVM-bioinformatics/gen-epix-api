# Example environment variables for secrets using environment strategy
# Set COMMONDB_SECRETS_STRATEGY=environment to use this approach

# Database configuration
COMMONDB_SECRET_DB__REPOSITORY_TYPE=DICT

# Log configuration
COMMONDB_SECRET_LOG__LEVEL=INFO

# No authentication user
COMMONDB_SECRET_NO_AUTHENTICATION__USER__ID=018bcd02-eb19-fb14-c520-64cbb78d9135
COMMONDB_SECRET_NO_AUTHENTICATION__USER__EMAIL=dummy@dummy.org

# Automatic new user configuration
COMMONDB_SECRET_AUTOMATIC_NEW_USER__ROLES=["ORG_USER"]
COMMONDB_SECRET_AUTOMATIC_NEW_USER__ORGANIZATION__ID=018d074d-e9fc-b282-fcaa-377a752b95e5
COMMONDB_SECRET_AUTOMATIC_NEW_USER__ORGANIZATION__NAME=DUMMY

# Root organization
COMMONDB_SECRET_ROOT__ORGANIZATION__ID=01915051-eddd-132c-a5c5-d05672295291
COMMONDB_SECRET_ROOT__ORGANIZATION__NAME=DUMMY
COMMONDB_SECRET_ROOT__ORGANIZATION__LEGAL_ENTITY_CODE=DUMMY

# Root user
COMMONDB_SECRET_ROOT__USER__ID=01915051-edde-f225-19d7-7ab8886e00bc
COMMONDB_SECRET_ROOT__USER__EMAIL=root@dummy.org

# CommonDB user
COMMONDB_SECRET_COMMONDB__USER__ID=01915051-edde-f225-19d7-7ab8886e00bc
COMMONDB_SECRET_COMMONDB__USER__EMAIL=root@dummy.org
COMMONDB_SECRET_COMMONDB__USER__ORGANIZATION_ID=01915051-eddd-132c-a5c5-d05672295291
COMMONDB_SECRET_COMMONDB__USER__ROLES=["APP_ADMIN"]

# Repository configuration - DICT defaults
COMMONDB_SECRET_REPOSITORY__DICT__DEFAULTS__DIR=./data/commondb/demo

# Repository configuration - DICT files
COMMONDB_SECRET_REPOSITORY__DICT__AUTH__FILE={dir}/commondb.dict.auth.full.pkl.gz
COMMONDB_SECRET_REPOSITORY__DICT__CASE__FILE={dir}/commondb.dict.case.full.pkl.gz
COMMONDB_SECRET_REPOSITORY__DICT__GEO__FILE={dir}/commondb.dict.geo.full.pkl.gz

# Repository configuration - SQL Server defaults
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__DRIVER=ODBC Driver 18 for SQL Server
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__SERVER=127.0.0.1
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__DATABASE=DUMMY
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__UID=DUMMY
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__PWD=DUMMY
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__OTHER=""
COMMONDB_SECRET_REPOSITORY__SA_SQL__DEFAULTS__CONNECTION_STRING="mssql+pyodbc:///?odbc_connect=DRIVER={driver};SERVER={server};DATABASE={database};UID={uid};PWD={pwd}{other}"