# Example environment variables for settings overrides
# These can be used to override default settings

# Application settings
COMMONDB_APP__HOST=0.0.0.0
COMMONDB_APP__PORT=8080
COMMONDB_APP__DEBUG=false

# API settings  
COMMONDB_API__DEFAULT_ROUTE=/openapi.json
COMMONDB_API__GZIP_RESPONSE_MINIMUM_SIZE=2048

# Nested settings example - override HTTP headers
COMMONDB_API__HTTP_HEADER__GENERAL__CACHcontrol="no-store"

# Service settings
COMMONDB_SERVICE__RBAC__USER_INVITATION_TIME_TO_LIVE=86400

# Log level
COMMONDB_LOG__LEVEL=INFO